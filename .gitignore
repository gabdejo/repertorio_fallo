# Virtual environment
.venv/
venv/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Spotify token cache (created by spotipy)
.cache
.cache-*

# Spotify/Last.fm API caches are versioned on purpose (rate-limited to rebuild,
# see feedback_external-api-pacing memory). Processed CSVs are cheap to rebuild
# from the cache + dictionaries, so those stay regenerable/ignored.
data/processed/*.csv
data/processed/*.pdf